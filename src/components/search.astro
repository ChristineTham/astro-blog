---

---

<script>
  import lunr from 'lunr'

  interface SearchDoc {
    url: string
    title: string
    description: string
  }

  interface SearchHit {
    ref: string
  }

  interface LunrIndex {
    search: (term: string) => SearchHit[]
  }

  interface SearchState {
    searchResults: boolean
    searchText: string
    idx: LunrIndex | null
    docs: SearchDoc[] | null
    results: SearchDoc[]
    title: string
    ensureIndex: () => Promise<void>
    runSearch: () => Promise<void>
  }

  declare global {
    interface Window {
      lunrSearch: () => SearchState
    }
  }

  window.lunrSearch = (): SearchState => ({
    searchResults: false,
    searchText: '',
    idx: null,
    docs: null,
    results: [],
    title: 'Search results',
    async ensureIndex() {
      if (!this.docs) {
        const docsRes = await fetch(`${import.meta.env.BASE_URL}search-docs.json`)
        this.docs = (await docsRes.json()) as SearchDoc[]
      }
      if (!this.idx) {
        const idxRes = await fetch(`${import.meta.env.BASE_URL}search-index.json`)
        const data = await idxRes.json()
        this.idx = lunr.Index.load(data) as LunrIndex
      }
    },
    async runSearch() {
      const term = this.searchText.trim()
      this.results = []

      if (!term) {
        this.title = 'Search results'
        this.searchResults = false
        return
      }

      this.searchResults = true
      this.title = `Search results for '${term}'`
      await this.ensureIndex()
      if (!this.idx || !this.docs) {
        return
      }

      const hits = this.idx.search(term)
      const docs = this.docs
      this.results = hits
        .map((hit: SearchHit) => docs.find((doc: SearchDoc) => doc.url === hit.ref))
        .filter((doc: SearchDoc | undefined): doc is SearchDoc => Boolean(doc))
    }
  })
</script>
<div x-data="lunrSearch()">
  <div class="flex justify-center">
    <div class="w-48">
      <div class="input-group flex w-full items-stretch relative">
        <input
          type="search"
          x-model="searchText"
          class="form-control text-base text-gray-500 font-normal m-0 px-3 py-1.5 border border-purple-300 rounded-sm border-solid bg-white flex-auto max-w-xs min-w-0 w-full block transition ease-in-out relative bg-clip-padding dark:text-gray-300 focus:text-gray-700 focus:outline-hidden dark:border-purple-700 focus:border-purple-500 dark:bg-gray-900 dark:focus:text-gray-100 dark:focus:border-purple-600"
          id="lunrsearch"
          name="q"
          maxlength="255"
          value=""
          placeholder="Search"
          x-on:input.debounce.300ms="runSearch()"
          x-on:keydown.enter.prevent="runSearch()"
          aria-label="Search"
          aria-describedby="lunrbutton"
        />
        <button
          class="btn text-xs text-white leading-tight font-medium px-2 py-2 rounded-sm bg-purple-600 inline-block uppercase shadow-md transition duration-150 ease-in-out items-center focus:outline-hidden active:bg-purple-800 focus:bg-purple-700 hover:bg-purple-700 focus:ring-0 active:shadow-lg focus:shadow-lg hover:shadow-lg"
          type="button"
          name="search"
          id="lunrbutton"
          x-on:click="runSearch()"
          aria-label="Search Button"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            data-prefix="fas"
            data-icon="search"
            class="h-4 w-4"
            role="img"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 512 512"
          >
            <path
              fill="currentColor"
              d="M505 442.7L405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div
    x-show="searchResults"
    x-cloak
    class="relative z-50"
    aria-labelledby="slide-over-title"
    role="dialog"
    aria-modal="true"
  >
    <div
      x-show="searchResults"
      x-transition:enter="ease-in-out duration-500"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="ease-in-out duration-500"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="bg-gray-500 bg-opacity-75 transition-opacity inset-0 fixed"
    >
    </div>

    <div class="inset-0 fixed overflow-hidden">
      <div class="inset-0 absolute overflow-hidden">
        <div class="pl-10 flex max-w-full pointer-events-none inset-y-0 right-0 fixed">
          <div
            x-show="searchResults"
            x-transition:enter="transform transition ease-in-out duration-500 sm:duration-700"
            x-transition:enter-start="translate-x-full"
            x-transition:enter-end="translate-x-0"
            x-transition:leave="transform transition ease-in-out duration-500 sm:duration-700"
            x-transition:leave-start="translate-x-0"
            x-transition:leave-end="translate-x-full"
            class="max-w-md w-screen pointer-events-auto relative"
          >
            <div
              x-show="searchResults"
              x-transition:enter="ease-in-out duration-500"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="ease-in-out duration-500"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
              class="pr-2 pt-4 flex left-0 top-0 absolute -ml-8 sm:pr-4 sm:-ml-10"
            >
              <button
                type="button"
                class="text-purple-300 rounded-md hover:text-pink-300 focus:outline-hidden focus:ring-2 focus:ring-white"
                x-on:click="searchResults = false"
              >
                <span class="sr-only">Close panel</span>
                <div class="i-heroicons-x-mark h-6 w-6"></div>
              </button>
            </div>

            <div
              class="py-6 bg-white flex flex-col h-full shadow-xl overflow-y-scroll dark:bg-gray-800"
            >
              <div class="px-4 sm:px-6">
                <h2
                  class="text-lg text-gray-900 font-medium dark:text-gray-100"
                  id="lunrsearchtitle"
                >
                  <span x-text="title"></span>
                </h2>
              </div>
              <div id="lunrsearchmodal" class="mt-6 px-4 flex-1 relative sm:px-6">
                <div
                  id="lunrsearchresults"
                  class="rounded-lg ring-1 ring-black ring-opacity-5 shadow-lg overflow-hidden"
                >
                  <ul
                    class="px-5 py-6 bg-white gap-6 grid relative dark:text-gray-100 sm:p-8 dark:bg-gray-700 sm:gap-8"
                  >
                    <template x-if="!results.length && searchText.trim()">
                      <li>No results found...</li>
                    </template>
                    <template x-for="result in results" :key="result.url">
                      <li class="p-3 rounded-lg -m-3 hover:bg-purple-200 dark:hover:bg-purple-900">
                        <a href="/" x-bind:href="result.url">
                          <p
                            class="text-base text-gray-900 font-medium dark:text-gray-100"
                            x-text="result.title"
                          >
                          </p>
                          <p
                            class="text-sm text-gray-500 mt-1 dark:text-gray-400"
                            x-text="result.description"
                          >
                          </p>
                        </a>
                      </li>
                    </template>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
